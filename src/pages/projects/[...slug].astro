---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const slugText = Array.isArray(slug) ? slug.join('/') : slug ?? '';
---

<BaseLayout title="历史兼容内容" description="项目详情页已不再作为 Daniel实验室 的主前台结构">
  <section class="compat-page">
    <p class="kicker">历史兼容详情页</p>
    <h1>这个项目详情页已退出前台主结构</h1>
    <p class="lead">
      当前访问的是历史兼容链接：<code>/projects/{slugText}</code>。Daniel实验室 现在优先通过文章与专题来组织公开内容。
    </p>
    <div class="compat-card">
      <p>
        底层 `projects` 数据仍保留，主要是为了兼容旧链接与后续整理，不代表它仍是站点主前台内容类型。
      </p>
      <div class="actions">
        <a href="/articles" class="btn btn-primary">去文章页</a>
        <a href="/topics" class="btn">去专题页</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .compat-page {
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .kicker {
    color: var(--accent-color);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .lead {
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .compat-card {
    padding: 1.5rem;
    border: 1px solid var(--border-color);
    border-radius: 14px;
    background: var(--bg-secondary);
  }

  .compat-card p {
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
