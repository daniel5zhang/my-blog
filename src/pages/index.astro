---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig, topicConfig } from '../lib/site';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const recentArticles = articles.slice(0, 6);
const featuredArticles = articles.filter((article) => article.data.featured).slice(0, 3);

const categoryMap = new Map<string, number>();
for (const article of articles) {
  if (!article.data.category) continue;
  categoryMap.set(article.data.category, (categoryMap.get(article.data.category) ?? 0) + 1);
}
const categories = Array.from(categoryMap.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 6);

const tagMap = new Map<string, number>();
for (const article of articles) {
  for (const tag of article.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
  }
}
const topTags = Array.from(tagMap.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 10);
---

<BaseLayout title="Daniel实验室" description={siteConfig.description}>
  <section class="hero sketch-panel">
    <div class="hero-note">AI 手绘实验中</div>
    <p class="hero-kicker">{siteConfig.tagline}</p>
    <h1>Daniel实验室</h1>
    <p class="hero-description">
      这里不再是作品陈列柜，而是一个持续更新的内容中枢：我会把 AI、自动化和数字工作流里真正重要的变化，拆开、讲透、留下判断。
    </p>
    <div class="hero-links">
      <a href="/articles" class="btn btn-primary">开始读文章</a>
      <a href="/subscribe" class="btn">优先订阅更新</a>
    </div>
  </section>

  {featuredArticles.length > 0 && (
    <section class="section">
      <div class="section-header">
        <h2>推荐阅读</h2>
        <a href="/articles">全部文章 →</a>
      </div>
      <div class="card-grid">
        {featuredArticles.map((article) => (
          <article class="card feature-card sketch-panel">
            <span class="feature-badge">推荐</span>
            <h3><a href={`/articles/${article.slug}`}>{article.data.title}</a></h3>
            <p class="card-meta">
              <time datetime={article.data.publishedAt.toISOString()}>
                {article.data.publishedAt.toLocaleDateString('zh-CN')}
              </time>
              {article.data.category && <span>· {article.data.category}</span>}
            </p>
            <p>{article.data.summary}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-header">
      <h2>最新文章</h2>
      <a href="/articles">查看全部 →</a>
    </div>
    {recentArticles.length > 0 ? (
      <div class="card-grid">
        {recentArticles.map((article) => (
          <article class="card sketch-panel">
            <h3><a href={`/articles/${article.slug}`}>{article.data.title}</a></h3>
            <p class="card-meta">
              <time datetime={article.data.publishedAt.toISOString()}>
                {article.data.publishedAt.toLocaleDateString('zh-CN')}
              </time>
              {article.data.category && <span>· {article.data.category}</span>}
            </p>
            <p>{article.data.summary}</p>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-state">暂无文章，后续会从这里持续更新。</p>
    )}
  </section>

  <section class="section split-grid">
    <div class="panel sketch-panel">
      <div class="section-header compact">
        <h2>专题入口</h2>
        <a href="/topics">全部专题 →</a>
      </div>
      <div class="item-list">
        {topicConfig.map((topic) => (
          <a class="item-card" href={`/topics#${topic.slug}`}>
            <strong>{topic.title}</strong>
            <span>{topic.description}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="panel sketch-panel">
      <div class="section-header compact">
        <h2>热门标签</h2>
        <a href="/tags">全部标签 →</a>
      </div>
      {topTags.length > 0 ? (
        <div class="tag-list">
          {topTags.map((tag) => (
            <a class="tag-pill" href={`/tags/${tag.name}`}>
              <span>{tag.name}</span>
              <em>{tag.count}</em>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-state">暂无标签数据。</p>
      )}
    </div>
  </section>

  <section class="section split-grid">
    <div class="panel sketch-panel">
      <div class="section-header compact">
        <h2>主题聚合</h2>
        <a href="/archive">进入归档 →</a>
      </div>
      {categories.length > 0 ? (
        <div class="item-list">
          {categories.map((category) => (
            <a class="item-card" href={`/categories/${category.name}`}>
              <strong>{category.name}</strong>
              <span>{category.count} 篇文章</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-state">暂无分类数据。</p>
      )}
    </div>

    <div class="panel callout sketch-panel">
      <h2>订阅优先</h2>
      <p>Daniel实验室把订阅放在更前面。你可以直接通过 RSS / JSON Feed 跟进所有更新，而不用反复来网站碰运气。</p>
      <a href="/subscribe" class="btn btn-primary">查看订阅方式</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    text-align: center;
    padding: clamp(2rem, 6vw, 4rem) clamp(1rem, 3vw, 2.5rem);
    margin-bottom: 2.5rem;
    overflow: hidden;
  }

  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    pointer-events: none;
    border-radius: 999px;
  }

  .hero::before {
    width: 11rem;
    height: 11rem;
    left: -3rem;
    top: -2.5rem;
    background: radial-gradient(circle, rgba(251, 191, 36, 0.22), transparent 70%);
  }

  .hero::after {
    width: 9rem;
    height: 9rem;
    right: -2rem;
    bottom: -2rem;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.18), transparent 70%);
  }

  .hero-note {
    display: inline-flex;
    margin-bottom: 0.75rem;
    padding: 0.35rem 0.85rem;
    border: 2px dashed rgba(15, 23, 42, 0.25);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.8);
    color: var(--accent-color);
    font-size: 0.85rem;
    font-weight: 700;
    transform: rotate(-4deg);
  }

  .hero-kicker {
    color: var(--accent-color);
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
  }

  .hero h1 {
    margin-bottom: 1rem;
  }

  .hero-description {
    font-size: 1.08rem;
    color: var(--text-secondary);
    max-width: 760px;
    margin: 0 auto 2rem;
    line-height: 1.9;
  }

  .hero-links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .section {
    margin-bottom: 3rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .section-header h2 {
    position: relative;
    display: inline-block;
    padding-bottom: 0.25rem;
  }

  .section-header h2::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 0.55rem;
    background: linear-gradient(90deg, rgba(251, 191, 36, 0.45), rgba(45, 212, 191, 0));
    z-index: -1;
    transform: skewX(-12deg);
  }

  .section-header.compact {
    margin-bottom: 1rem;
  }

  .section-header a {
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .card-grid,
  .split-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .sketch-panel {
    position: relative;
    border: 1px solid rgba(15, 23, 42, 0.14);
    border-radius: 24px 20px 22px 18px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(255, 252, 245, 0.9));
    box-shadow: 0 20px 40px rgba(15, 23, 42, 0.08), 0 2px 0 rgba(15, 23, 42, 0.08);
  }

  .sketch-panel::before {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px dashed rgba(15, 23, 42, 0.14);
    border-radius: 20px 18px 16px 22px;
    pointer-events: none;
  }

  .card,
  .panel {
    padding: 1.5rem;
  }

  .card {
    transition: transform 0.28s ease, box-shadow 0.28s ease;
  }

  .card:hover,
  .panel:hover,
  .item-card:hover,
  .tag-pill:hover {
    transform: translateY(-4px) rotate(-0.4deg);
    box-shadow: 0 18px 34px rgba(15, 23, 42, 0.1);
  }

  .feature-card {
    position: relative;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.12), rgba(16, 185, 129, 0.1));
  }

  .feature-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
    background: #2563eb;
    color: white;
    border-radius: 999px 999px 999px 4px;
    box-shadow: 2px 2px 0 rgba(15, 23, 42, 0.15);
  }

  .card h3 {
    margin-bottom: 0.5rem;
    font-size: 1.15rem;
  }

  .card-meta {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }

  .item-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .item-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.9rem 1rem;
    border-radius: 16px 14px 18px 12px;
    background: rgba(255, 255, 255, 0.9);
    color: inherit;
    text-decoration: none;
    border: 1px solid rgba(15, 23, 42, 0.12);
    transition: transform 0.24s ease, box-shadow 0.24s ease;
  }

  .item-card span,
  .empty-state,
  .callout p {
    color: var(--text-secondary);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.85rem;
    border-radius: 999px 999px 999px 10px;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(15, 23, 42, 0.12);
    color: inherit;
    text-decoration: none;
    transition: transform 0.24s ease, box-shadow 0.24s ease;
  }

  .tag-pill em {
    font-style: normal;
    color: var(--text-secondary);
    font-size: 0.82rem;
  }

  .callout {
    background: linear-gradient(135deg, rgba(250, 245, 255, 0.95), rgba(255, 252, 245, 0.92));
  }

  @media (max-width: 768px) {
    .hero {
      text-align: left;
      padding: 1.5rem 1rem 2rem;
    }

    .hero-links,
    .section-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .card-grid,
    .split-grid {
      grid-template-columns: 1fr;
    }

    .sketch-panel {
      border-radius: 20px 16px 18px 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .panel,
    .item-card,
    .tag-pill {
      transition: none;
    }
  }
</style>
