---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const recentArticles = articles.slice(0, 3);
const recentProjects = projects.slice(0, 3);

const categoryMap = new Map<string, { articles: number; projects: number }>();
for (const article of articles) {
  if (!article.data.category) continue;
  const current = categoryMap.get(article.data.category) ?? { articles: 0, projects: 0 };
  current.articles += 1;
  categoryMap.set(article.data.category, current);
}
for (const project of projects) {
  if (!project.data.category) continue;
  const current = categoryMap.get(project.data.category) ?? { articles: 0, projects: 0 };
  current.projects += 1;
  categoryMap.set(project.data.category, current);
}
const categories = Array.from(categoryMap.entries())
  .map(([name, counts]) => ({ name, ...counts, total: counts.articles + counts.projects }))
  .sort((a, b) => b.total - a.total)
  .slice(0, 6);

const tagMap = new Map<string, number>();
for (const article of articles) {
  for (const tag of article.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
  }
}
for (const project of projects) {
  for (const tag of project.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
  }
}
const topTags = Array.from(tagMap.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 8);
---

<BaseLayout title="首页" description="欢迎访问我的个人网站">
  <section class="hero">
    <h1>你好，我是 Daniel</h1>
    <p class="hero-description">
      这里是我的个人站点，用来长期发布文章、展示项目、沉淀知识与个人品牌。
    </p>
    <div class="hero-links">
      <a href="/articles" class="btn btn-primary">阅读文章</a>
      <a href="/projects" class="btn">查看项目</a>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>最新文章</h2>
      <a href="/articles">查看全部 →</a>
    </div>
    {recentArticles.length > 0 ? (
      <div class="card-grid">
        {recentArticles.map((article) => (
          <article class="card">
            <h3>
              <a href={`/articles/${article.slug}`}>{article.data.title}</a>
            </h3>
            <p class="card-meta">
              <time datetime={article.data.publishedAt.toISOString()}>
                {article.data.publishedAt.toLocaleDateString('zh-CN')}
              </time>
              {article.data.category && <span>· {article.data.category}</span>}
            </p>
            <p>{article.data.summary}</p>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-state">暂无文章，后续会从这里持续更新。</p>
    )}
  </section>

  <section class="section">
    <div class="section-header">
      <h2>精选项目</h2>
      <a href="/projects">查看全部 →</a>
    </div>
    {recentProjects.length > 0 ? (
      <div class="card-grid">
        {recentProjects.map((project) => (
          <article class="card">
            <h3>
              <a href={`/projects/${project.slug}`}>{project.data.name}</a>
            </h3>
            <p class="card-meta">
              <time datetime={project.data.publishedAt.toISOString()}>
                {project.data.publishedAt.toLocaleDateString('zh-CN')}
              </time>
              {project.data.status && <span>· {project.data.status}</span>}
            </p>
            <p>{project.data.summary}</p>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-state">暂无项目，后续会逐步补齐作品展示。</p>
    )}
  </section>

  <section class="section split-grid">
    <div class="panel">
      <div class="section-header compact">
        <h2>分类入口</h2>
        <a href="/categories">全部分类 →</a>
      </div>
      {categories.length > 0 ? (
        <div class="item-list">
          {categories.map((category) => (
            <a class="item-card" href={`/categories/${category.name}`}>
              <strong>{category.name}</strong>
              <span>{category.articles} 篇文章 · {category.projects} 个项目</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-state">暂无分类数据。</p>
      )}
    </div>

    <div class="panel">
      <div class="section-header compact">
        <h2>热门标签</h2>
        <a href="/tags">全部标签 →</a>
      </div>
      {topTags.length > 0 ? (
        <div class="tag-list">
          {topTags.map((tag) => (
            <a class="tag-pill" href={`/tags/${tag.name}`}>
              <span>{tag.name}</span>
              <em>{tag.count}</em>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-state">暂无标签数据。</p>
      )}
    </div>
  </section>

  <section class="section split-grid">
    <div class="panel callout">
      <h2>订阅更新</h2>
      <p>已支持 RSS 和 JSON Feed 统一订阅，可实时追踪文章与项目更新。</p>
      <a href="/subscribe" class="btn btn-primary">查看订阅方式</a>
    </div>

    <div class="panel callout">
      <h2>搜索入口</h2>
      <p>已提供本地搜索功能，可快速检索全站文章与项目内容。</p>
      <a href="/search" class="btn">进入搜索</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 3rem 0;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 2rem;
  }

  .hero h1 {
    margin-bottom: 1rem;
  }

  .hero-description {
    font-size: 1.25rem;
    color: var(--text-secondary);
    max-width: 680px;
    margin: 0 auto 2rem;
  }

  .hero-links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .section {
    margin-bottom: 3rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .section-header.compact {
    margin-bottom: 1rem;
  }

  .section-header a {
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .card-grid,
  .split-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .card h3 {
    margin-bottom: 0.5rem;
    font-size: 1.2rem;
  }

  .card-meta {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }

  .panel {
    padding: 1.5rem;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: var(--bg-secondary);
  }

  .callout p {
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .item-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .item-card {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1rem;
    border-radius: 10px;
    background: #fff;
    color: inherit;
    text-decoration: none;
    border: 1px solid var(--border-color);
  }

  .item-card span {
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.85rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--border-color);
    color: inherit;
    text-decoration: none;
  }

  .tag-pill em {
    font-style: normal;
    color: var(--text-secondary);
    font-size: 0.82rem;
  }

  .empty-state {
    color: var(--text-secondary);
    margin: 0;
  }
</style>
