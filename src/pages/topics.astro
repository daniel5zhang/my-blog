---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { topicConfig } from '../lib/site';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const topicMatchers = {
  'ai-observation': /ai|人工智能|大模型|模型|agent|openai|claude|gemini/i,
  automation: /自动化|workflow|工作流|agent|效率|自动/i,
  'digital-workflow': /数字|工作流|网站|内容|订阅|搜索|知识管理|系统/i,
};

const topicSections = topicConfig.map((topic) => {
  const matcher = topicMatchers[topic.slug as keyof typeof topicMatchers];
  const related = articles.filter((article) => {
    const text = [
      article.data.category ?? '',
      article.data.title,
      article.data.summary,
      ...(article.data.tags ?? []),
    ]
      .join(' ')
      .toLowerCase();

    return matcher.test(text);
  });

  return {
    ...topic,
    hero: related[0],
    latest: related.slice(0, 6),
    count: related.length,
  };
});
---

<BaseLayout title="专题" description="Daniel实验室 的第二主轴：按长期主题组织文章入口">
  <section class="page-header">
    <h1>专题</h1>
    <p>Daniel实验室 的第一主轴是文章，第二主轴就是专题。专题不是额外内容类型，而是把分散文章重新组织成长期值得追踪的问题域。</p>
  </section>

  <div class="topics-grid">
    {topicSections.map((topic) => (
      <section class="topic-card" id={topic.slug}>
        <div class="topic-head">
          <div>
            <h2>{topic.title}</h2>
            <p class="topic-description">{topic.description}</p>
          </div>
          <span class="topic-count">{topic.count} 篇相关文章</span>
        </div>

        {topic.hero && (
          <article class="topic-hero">
            <p class="hero-kicker">先看这一篇</p>
            <h3><a href={`/articles/${topic.hero.slug}`}>{topic.hero.data.title}</a></h3>
            <p>{topic.hero.data.summary}</p>
          </article>
        )}

        {topic.latest.length > 0 ? (
          <ul class="topic-list">
            {topic.latest.map((article) => (
              <li>
                <a href={`/articles/${article.slug}`}>{article.data.title}</a>
                <span>{article.data.publishedAt.toLocaleDateString('zh-CN')}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty-state">这个专题还在补内容，后面会持续充实。</p>
        )}
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
  }

  .page-header p,
  .topic-description,
  .empty-state,
  .topic-list span {
    color: var(--text-secondary);
  }

  .topics-grid {
    display: grid;
    gap: 1.5rem;
  }

  .topic-card {
    padding: 1.5rem;
    border: 1px solid var(--border-color);
    border-radius: 14px;
    background: var(--bg-secondary);
  }

  .topic-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: flex-start;
    margin-bottom: 1rem;
  }

  .topic-card h2 {
    margin-bottom: 0.5rem;
  }

  .topic-count {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .topic-hero {
    padding: 1rem;
    background: #fff;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    margin-bottom: 1rem;
  }

  .hero-kicker {
    font-size: 0.75rem;
    color: var(--accent-color);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .topic-hero h3 {
    margin-bottom: 0.5rem;
  }

  .topic-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    gap: 0.75rem;
  }

  .topic-list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-color);
  }
</style>
