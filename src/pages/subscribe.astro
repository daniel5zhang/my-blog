---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../lib/site';

const rssUrl = `${siteConfig.siteUrl}/rss.xml`;
const jsonFeedUrl = `${siteConfig.siteUrl}/feed.json`;
---

<BaseLayout title="订阅" description="订阅本站更新">
  <section class="page-header">
    <h1>订阅</h1>
    <p>通过以下方式订阅本站最新内容更新</p>
  </section>

  <section class="info-card">
    <h2>订阅内容范围</h2>
    <p>当前站点的统一订阅范围包括：</p>
    <ul class="content-list">
      <li>📝 <strong>文章</strong> - 技术文章、教程、经验分享</li>
      <li>🛠 <strong>项目</strong> - 个人项目展示、功能更新</li>
    </ul>
    <p class="note">订阅将聚合以上两类内容的最新更新，按更新时间倒序排列。</p>
  </section>

  <section class="feeds-section">
    <h2>可用 Feed</h2>
    <div class="feeds-grid">
      <article class="feed-card">
        <div class="feed-icon">📡</div>
        <div class="feed-info">
          <h3>RSS Feed</h3>
          <p>标准的 RSS 订阅格式，支持大多数阅读器和浏览器</p>
          <div class="feed-url">
            <code>{rssUrl}</code>
            <button class="copy-btn" data-url={rssUrl} aria-label="复制链接">
              复制
            </button>
          </div>
        </div>
      </article>

      <article class="feed-card">
        <div class="feed-icon">📋</div>
        <div class="feed-info">
          <h3>JSON Feed</h3>
          <p>机器可读的 JSON 格式，更适合程序化处理</p>
          <div class="feed-url">
            <code>{jsonFeedUrl}</code>
            <button class="copy-btn" data-url={jsonFeedUrl} aria-label="复制链接">
              复制
            </button>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="info-card">
    <h2>使用说明</h2>
    <ul class="instructions">
      <li>复制上述 Feed 地址，添加到你的 RSS 阅读器（如 Feedly、Inoreader 等）</li>
      <li>也可以直接在浏览器地址栏输入查看原始内容</li>
      <li>订阅将自动获取所有文章和项目的最新更新</li>
    </ul>
  </section>

  <section class="info-card reminder">
    <h2>暂不支持的功能</h2>
    <p>本阶段暂不提供以下功能：</p>
    <ul class="disabled-list">
      <li>邮件订阅</li>
      <li>消息推送订阅</li>
      <li>分类级 Feed 单独订阅</li>
    </ul>
  </section>
</BaseLayout>

<script>
  // 复制链接功能
  const copyButtons = document.querySelectorAll('.copy-btn');
  copyButtons.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-url');
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
        btn.textContent = '已复制!';
        setTimeout(() => {
          btn.textContent = '复制';
        }, 2000);
      } catch (err) {
        console.error('复制失败:', err);
      }
    });
  });
</script>

<style>
  .page-header {
    margin-bottom: 2rem;
  }

  .page-header p {
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  .info-card {
    padding: 1.5rem;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: var(--bg-secondary);
    margin-bottom: 1.5rem;
  }

  .info-card h2 {
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }

  .info-card p,
  .info-card li {
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .content-list {
    margin: 1rem 0;
    padding-left: 1.25rem;
  }

  .content-list li {
    margin-bottom: 0.5rem;
  }

  .note {
    font-size: 0.9rem;
    padding: 0.75rem;
    background: rgba(59, 130, 246, 0.1);
    border-radius: 8px;
    margin-top: 1rem;
  }

  .feeds-section {
    margin-bottom: 1.5rem;
  }

  .feeds-section h2 {
    margin-bottom: 1rem;
    font-size: 1.25rem;
  }

  .feeds-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
  }

  .feed-card {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: var(--bg-primary);
  }

  .feed-icon {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .feed-info h3 {
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }

  .feed-info p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }

  .feed-url {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .feed-url code {
    font-size: 0.75rem;
    padding: 0.4rem 0.6rem;
    background: var(--bg-secondary);
    border-radius: 6px;
    word-break: break-all;
    flex: 1;
    min-width: 150px;
  }

  .copy-btn {
    font-size: 0.75rem;
    padding: 0.4rem 0.75rem;
    background: #3b82f6;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s ease;
    white-space: nowrap;
  }

  .copy-btn:hover {
    background: #2563eb;
  }

  .instructions {
    margin: 0.75rem 0 0;
    padding-left: 1.25rem;
  }

  .instructions li {
    margin-bottom: 0.5rem;
  }

  .reminder {
    background: rgba(245, 158, 11, 0.1);
    border-color: rgba(245, 158, 11, 0.3);
  }

  .reminder h2 {
    color: #f59e0b;
  }

  .disabled-list {
    margin: 0.75rem 0 0;
    padding-left: 1.25rem;
  }

  .disabled-list li {
    opacity: 0.7;
  }
</style>