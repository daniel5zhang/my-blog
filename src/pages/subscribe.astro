---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../lib/site';

const rssUrl = `${siteConfig.siteUrl}/rss.xml`;
const jsonFeedUrl = `${siteConfig.siteUrl}/feed.json`;
---

<BaseLayout title="订阅" description="订阅 Daniel实验室 更新">
  <section class="page-header">
    <h1>订阅</h1>
    <p>Daniel实验室 是文章型内容中枢。网站是母稿，后续外部分发平台会从这里改写，而不是反过来。</p>
  </section>

  <section class="info-card">
    <h2>订阅范围</h2>
    <p>当前统一订阅范围只包括站内公开文章更新。</p>
    <ul class="content-list">
      <li>📝 <strong>文章</strong>：AI、自动化、数字工作流相关观察与实践</li>
      <li>🧭 <strong>专题沉淀</strong>：专题页作为聚合入口，底层更新仍以文章为主</li>
    </ul>
    <p class="note">项目数据目前仅作历史兼容保留，不再作为站点前台的独立内容类型对外暴露。</p>
  </section>

  <section class="feeds-section">
    <h2>可用 Feed</h2>
    <div class="feeds-grid">
      <article class="feed-card">
        <div class="feed-icon">📡</div>
        <div class="feed-info">
          <h3>RSS Feed</h3>
          <p>适合 Feedly、Inoreader 等阅读器，长期跟踪更新最省心。</p>
          <div class="feed-url">
            <code>{rssUrl}</code>
            <button class="copy-btn" data-url={rssUrl} aria-label="复制链接">复制</button>
          </div>
        </div>
      </article>

      <article class="feed-card">
        <div class="feed-icon">📋</div>
        <div class="feed-info">
          <h3>JSON Feed</h3>
          <p>适合程序化处理，也方便后续接自动化工作流。</p>
          <div class="feed-url">
            <code>{jsonFeedUrl}</code>
            <button class="copy-btn" data-url={jsonFeedUrl} aria-label="复制链接">复制</button>
          </div>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>

<script>
  const copyButtons = document.querySelectorAll('.copy-btn');
  copyButtons.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-url');
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
        btn.textContent = '已复制!';
        setTimeout(() => {
          btn.textContent = '复制';
        }, 2000);
      } catch (err) {
        console.error('复制失败:', err);
      }
    });
  });
</script>

<style>
  .page-header {
    margin-bottom: 2rem;
  }

  .page-header p {
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  .info-card {
    padding: 1.5rem;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: var(--bg-secondary);
    margin-bottom: 1.5rem;
  }

  .info-card h2 {
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }

  .info-card p,
  .info-card li {
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .content-list {
    margin: 1rem 0;
    padding-left: 1.25rem;
  }

  .note {
    font-size: 0.9rem;
    padding: 0.75rem;
    background: rgba(59, 130, 246, 0.1);
    border-radius: 8px;
    margin-top: 1rem;
  }

  .feeds-section {
    margin-bottom: 1.5rem;
  }

  .feeds-section h2 {
    margin-bottom: 1rem;
    font-size: 1.25rem;
  }

  .feeds-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
  }

  .feed-card {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: var(--bg-primary);
  }

  .feed-icon {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .feed-info h3 {
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }

  .feed-info p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }

  .feed-url {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .feed-url code {
    font-size: 0.75rem;
    padding: 0.4rem 0.6rem;
    background: var(--bg-secondary);
    border-radius: 6px;
    word-break: break-all;
    flex: 1;
    min-width: 150px;
  }

  .copy-btn {
    font-size: 0.75rem;
    padding: 0.4rem 0.75rem;
    background: #3b82f6;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s ease;
    white-space: nowrap;
  }
</style>
