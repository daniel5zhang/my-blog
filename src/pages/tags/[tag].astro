---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  const tags = Array.from(new Set([
    ...articles.flatMap((article) => article.data.tags),
    ...projects.flatMap((project) => project.data.tags),
  ]));

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      articles: articles.filter((article) => article.data.tags.includes(tag)),
      projects: projects.filter((project) => project.data.tags.includes(tag)),
    },
  }));
}

const { tag, articles, projects } = Astro.props;
---

<BaseLayout title={`${tag} 标签`} description={`查看 ${tag} 标签下的内容`}>
  <section class="page-header">
    <h1>#{tag}</h1>
    <p>该标签下共 {articles.length} 篇文章、{projects.length} 个项目。</p>
  </section>

  <section class="section">
    <h2>文章</h2>
    {articles.length > 0 ? (
      <div class="list-grid">
        {articles.map((article) => (
          <article class="item-card">
            <h3><a href={`/articles/${article.slug}`}>{article.data.title}</a></h3>
            <p class="meta">{article.data.publishedAt.toLocaleDateString('zh-CN')}</p>
            <p>{article.data.summary}</p>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-state">该标签下暂无文章。</p>
    )}
  </section>

  <section class="section">
    <h2>项目</h2>
    {projects.length > 0 ? (
      <div class="list-grid">
        {projects.map((project) => (
          <article class="item-card">
            <h3><a href={`/projects/${project.slug}`}>{project.data.name}</a></h3>
            <p class="meta">
              {project.data.publishedAt.toLocaleDateString('zh-CN')}
              {project.data.status && <span>· {project.data.status}</span>}
            </p>
            <p>{project.data.summary}</p>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-state">该标签下暂无项目。</p>
    )}
  </section>
</BaseLayout>

<style>
  .page-header,
  .section {
    margin-bottom: 2rem;
  }

  .page-header p,
  .meta,
  .empty-state {
    color: var(--text-secondary);
  }

  .list-grid {
    display: grid;
    gap: 1rem;
  }

  .item-card {
    padding: 1.25rem;
    border: 1px solid var(--border-color);
    border-radius: 10px;
  }

  .item-card h3 {
    margin-bottom: 0.35rem;
  }

  .meta {
    margin-bottom: 0.6rem;
    font-size: 0.875rem;
  }
</style>
