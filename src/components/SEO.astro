---
import type { SEOProps } from '../types';
import { siteConfig } from '../lib/site';

interface Props extends SEOProps {}

const {
  title,
  description = siteConfig.description,
  image,
  type = 'website',
  publishedTime,
  updatedTime,
  keywords = [],
  noIndex = false,
  canonicalPath,
  schemaData,
} = Astro.props;

const buildAbsoluteUrl = (value: string) => new URL(value, siteConfig.siteUrl).toString();
const plainTitle = title ?? siteConfig.title;
const pageTitle = title ? `${title} | ${siteConfig.title}` : siteConfig.title;
const canonicalUrl = buildAbsoluteUrl(canonicalPath ?? Astro.url.pathname);
const pageUrl = canonicalUrl;
const imageUrl = buildAbsoluteUrl(image ?? siteConfig.defaultOgImage);
const robots = noIndex ? 'noindex, nofollow' : 'index, follow';
const ogType = type === 'article' ? 'article' : 'website';

const defaultSchema =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: plainTitle,
        description,
        inLanguage: siteConfig.locale,
        author: {
          '@type': 'Person',
          name: siteConfig.author,
        },
        mainEntityOfPage: pageUrl,
        datePublished: publishedTime?.toISOString(),
        dateModified: (updatedTime ?? publishedTime)?.toISOString(),
        image: imageUrl,
        keywords,
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: plainTitle,
        description,
        inLanguage: siteConfig.locale,
        url: pageUrl,
        image: imageUrl,
      };

const jsonLd = JSON.stringify(schemaData ?? defaultSchema).replace(/</g, '\\u003c');
---

<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalUrl} />

{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}

<meta property="og:type" content={ogType} />
<meta property="og:url" content={pageUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:locale" content={siteConfig.locale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{type === 'article' && publishedTime && (
  <>
    <meta property="article:published_time" content={publishedTime.toISOString()} />
    {(updatedTime ?? publishedTime) && (
      <meta property="article:modified_time" content={(updatedTime ?? publishedTime).toISOString()} />
    )}
  </>
)}

<script is:inline type="application/ld+json" set:html={jsonLd}></script>
