# 站点配置环境变量示例
# 复制此文件为 .env.local 后修改使用

PUBLIC_SITE_TITLE=Daniel实验室
PUBLIC_SITE_TAGLINE=AI、自动化与数字工作流观察
PUBLIC_SITE_DESCRIPTION=Daniel实验室，持续观察 AI、自动化与数字工作流的变化，记录值得长期复用的方法、工具和判断。
PUBLIC_SITE_URL=https://example.com
PUBLIC_AUTHOR=Daniel
PUBLIC_SITE_LOCALE=zh-CN
PUBLIC_DEFAULT_OG_IMAGE=/og-default.svg

# Giscus 评论配置（未配置完整时，前端只显示“评论未启用”）
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=
PUBLIC_GISCUS_MAPPING=pathname
PUBLIC_GISCUS_THEME=preferred_color_scheme
PUBLIC_GISCUS_LANG=zh-CN
PUBLIC_GISCUS_INPUT_POSITION=top
PUBLIC_GISCUS_REACTIONS_ENABLED=1
PUBLIC_GISCUS_EMIT_METADATA=0
